# Same Postgres database as the CRM, but its OWN schema.
#
# ?schema=membership is load-bearing. The CRM tracks its migrations in
# public._prisma_migrations; pointing this app at public too would make each
# app see the other's migrations as unknown and refuse to deploy. A separate
# schema gives this app its own tables and its own migration history.
DATABASE_URL="postgresql://postgres:password@localhost:5432/madar_crm?schema=membership"

# Signs member session cookies. MUST be different from the CRM's CRM_AUTH_SECRET,
# so a staff session can never validate as a member session. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
MEMBER_AUTH_SECRET=""

# Public URL of this app, used for OAuth redirects and password-reset links.
NEXT_PUBLIC_APP_URL="https://madarorbit.com/membership"

# Origin of the static marketing site, used for the shared stylesheet, the logos
# and the nav links. Leave EMPTY in production, where both are on one domain.
# In local development set it to https://madarorbit.com so the pages still
# pick up the site styles.
NEXT_PUBLIC_SITE_ORIGIN=""

# Google sign-in (optional). The button is hidden entirely until both are set.
# Authorised redirect URI: https://madarorbit.com/membership/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Password-reset emails. Without a key the reset link is logged, not sent.
RESEND_API_KEY=""
EMAIL_FROM="Madar Hub <noreply@madarorbit.com>"

# Server-to-server checkout against the CRM. Must match INTERNAL_API_SECRET in
# the CRM's .env — that route creates the Pesapal order and knows the pricing.
INTERNAL_API_SECRET=""
CRM_BASE_URL="https://madarorbit.com/crm"
