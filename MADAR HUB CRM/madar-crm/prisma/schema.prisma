// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Lead {
  id                  String    @id @default(cuid())
  name                String?
  phone               String
  // Primary identifier for the member portal: an account is matched to this
  // record by email first, falling back to phone for the members who predate
  // email collection. Not unique — historic rows may share or lack one.
  email               String?
  // Set by the portal when a member account is connected to this record, so
  // staff can see who is on the portal without the CRM reaching into the
  // portal's own schema.
  portalLinkedAt      DateTime?
  source              String
  interest            String?
  suggestedPackageId  String?
  suggestedPackage    Package?  @relation(fields: [suggestedPackageId], references: [id])
  status              String
  visitDate           DateTime?
  followUpDate        DateTime?
  paymentStatus       String    @default("Pending")
  amountPaid          Int       @default(0)
  notes               String?
  rawWhatsappSnippet  String?
  aiSummary           String?
  importantNotes      String?
  aiConfidence        Float?
  leadType            String?
  language            String?
  budgetMentioned     String?
  numberOfPeople      Int?
  requestedDate       String?
  requestedTime       String?
  equipmentRequest    String?
  nextAction          String?
  lastCustomerMessage String?
  visitIntent         Boolean   @default(false)
  paymentIntent       Boolean   @default(false)
  locationRequest     Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  payments        Payment[]
  visits          Visit[]
  interactions    Interaction[]
  pesapalPayments PesapalPayment[]
  momoPayments    MomoPayment[]
  portalInvites   PortalInvite[]
  reminderLogs    MemberReminderLog[]
  subscriptions   Subscription[]
  invoices        Invoice[]

  @@index([status])
  @@index([followUpDate])
  @@index([phone])
  @@index([email])
}

model Payment {
  id             String        @id @default(cuid())
  leadId         String
  lead           Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  packageId      String?
  package        Package?      @relation(fields: [packageId], references: [id])
  // Which of the person's subscriptions this payment renews. Null for a
  // one-off purchase (day pass, meeting room) that renews nothing.
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  amount         Int
  paymentMethod  String
  paymentDate    DateTime      @default(now())
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  invoice        Invoice?

  @@index([leadId])
  @@index([paymentDate])
  @@index([subscriptionId])
}

model Visit {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  visitDate DateTime
  status    String   @default("Scheduled")
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([leadId])
  @@index([visitDate])
}

model Package {
  id          String   @id @default(cuid())
  name        String
  slug        String?  @unique
  price       Int
  billingType String   @default("monthly")
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  leadsAsSuggested Lead[]
  payments         Payment[]
  pesapalPayments  PesapalPayment[]
  momoPayments     MomoPayment[]
  subscriptions    Subscription[]
  invoices         Invoice[]
}

model Interaction {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type      String
  content   String
  createdAt DateTime @default(now())

  @@index([leadId])
  @@index([createdAt])
}

model MessageTemplate {
  id        String   @id @default(cuid())
  title     String
  body      String
  category  String   @default("general")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Online checkout initiated from the public madarorbit.com site. Distinct from
// Payment (which records payments staff enter manually) because a Pesapal
// order exists before we know whether the customer actually paid.
model PesapalPayment {
  id                String        @id @default(cuid())
  merchantReference String        @unique
  packageId         String?
  package           Package?      @relation(fields: [packageId], references: [id])
  packageName       String
  amount            Int // VAT-inclusive sale price: what settles to the bank and what the CRM books
  chargedAmount     Int? // what Pesapal billed: amount plus Pesapal's 3% surcharge
  currency          String        @default("RWF")
  customerName      String
  customerEmail     String
  customerPhone     String?
  status            String        @default("PENDING") // PENDING | COMPLETED | FAILED | ABANDONED
  // Where the checkout started: "website" (public pricing page) or
  // "membership" (a signed-in member paying from the portal). A membership
  // order already knows its Lead, so fulfilment does not have to guess.
  // The subscription a portal member chose to renew. Null for a public order,
  // or a new purchase; fulfilment then decides where the payment belongs.
  subscriptionId    String?
  subscription      Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  source            String        @default("website")
  pesapalTrackingId String?
  leadId            String?
  lead              Lead?         @relation(fields: [leadId], references: [id])
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([status])
  @@index([customerEmail])
}

// An MTN MoMo checkout. Kept separate from PesapalPayment rather than folded
// into it with a `provider` column: the two providers key their transactions
// differently (Pesapal by order tracking id, MoMo by the reference id we mint
// ourselves) and the live Pesapal table should not be migrated under a running
// checkout. Both feed the same Payment/Lead records once they complete.
model MomoPayment {
  id                String        @id @default(cuid())
  merchantReference String        @unique
  // The UUID sent to MTN as X-Reference-Id. The only handle for polling the
  // transaction, so a row without one can never be resolved.
  momoReferenceId   String?       @unique
  packageId         String?
  package           Package?      @relation(fields: [packageId], references: [id])
  packageName       String
  // VAT-inclusive sale price, and what MoMo actually billed. Equal today —
  // MoMo carries no surcharge — but kept as two columns so the CRM books the
  // sale price regardless of what a future fee does to the charge.
  amount            Int
  chargedAmount     Int?
  currency          String        @default("RWF")
  customerName      String
  customerEmail     String?
  // The MSISDN the prompt was pushed to, in international digits.
  customerPhone     String
  status            String        @default("PENDING") // PENDING | COMPLETED | FAILED | ABANDONED
  // "website" (public pricing page) or "membership" (signed-in portal member).
  // The subscription a portal member chose to renew. Null for a public order,
  // or a new purchase; fulfilment then decides where the payment belongs.
  subscriptionId    String?
  subscription      Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  source            String        @default("website")
  // MTN's rejection reason, kept so staff can tell a wrong PIN from no funds.
  failureReason     String?
  leadId            String?
  lead              Lead?         @relation(fields: [leadId], references: [id])
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([status])
  @@index([customerPhone])
}

// A one-time link staff send a member so they can create a portal account.
// Most members arrive by WhatsApp or walk in, so the invite is what brings them
// onto the portal; the token also guarantees the new account attaches to the
// right Lead instead of relying on them typing a matching phone number.
model PortalInvite {
  id         String    @id @default(cuid())
  leadId     String
  lead       Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  // sha256 of the emailed/messaged token; the raw value is never stored.
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([leadId, createdAt])
}

// One row per reminder actually sent to a member, so a daily cron cannot mail
// the same person about the same due date twice. The unique constraint is the
// guarantee — the code does not have to remember.
model MemberReminderLog {
  id             String        @id @default(cuid())
  leadId         String
  lead           Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  // The subscription that fell due. A person with three subscriptions due on
  // the same day gets three reminders, one per subscription. Null only on
  // rows logged before subscriptions existed for a lead that has none.
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  // The nextPaymentDate this reminder was about, at day precision.
  dueDate        DateTime
  // "due_soon" (3 days before) | "due_now" (due date passed) | "final_notice"
  stage          String
  sentTo         String
  sentAt         DateTime      @default(now())

  @@unique([subscriptionId, dueDate, stage])
  @@index([leadId])
  @@index([sentAt])
}

// One thing a person pays for on a recurring basis. A person (Lead) can hold
// several — Zuna Real Estate, Zuna Logistics and Zuna Trio are three
// subscriptions under one contact, each with its own plan, due date and
// payment status, billed and reminded separately.
//
// The plan and due date are not stored as such: the due date follows from the
// latest Payment linked here and the period of `package`, exactly as a single
// membership did before (see src/lib/membership.ts).
model Subscription {
  id          String    @id @default(cuid())
  leadId      String
  lead        Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  // What the member calls it, usually the business it covers. Null when a
  // person has only the one and the plan name says enough.
  label       String?
  // The plan this subscription renews on. Updated whenever a payment for a
  // different package is booked against it, so it is always the current plan.
  packageId   String?
  package     Package?  @relation(fields: [packageId], references: [id])
  // "active" | "cancelled". A cancelled subscription is neither billed nor
  // reminded, but keeps its payment history.
  status      String    @default("active")
  startDate   DateTime  @default(now())
  cancelledAt DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  payments        Payment[]
  pesapalPayments PesapalPayment[]
  momoPayments    MomoPayment[]
  reminderLogs    MemberReminderLog[]

  @@index([leadId])
  @@index([status])
}

// A sales invoice issued on RRA's EBM. The CRM does not talk to EBM itself:
// staff type the figures from the invoice page into EBM, then copy the receipt
// number and SDC ID it prints back here. That turns the draft into a line of
// the sales ledger the VAT and income tax reports are built from.
//
// Buyer and item details are copied in rather than read through the lead or
// package, so a filed invoice never changes when a contact or price does.
model Invoice {
  id               String    @id @default(cuid())
  // Tax records outlive the CRM records they were raised from.
  leadId           String?
  lead             Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  paymentId        String?   @unique
  payment          Payment?  @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  packageId        String?
  package          Package?  @relation(fields: [packageId], references: [id], onDelete: SetNull)
  // Nine-digit RRA TIN. Null for an individual buyer without one (written
  // as 999999999 in RRA's annex).
  buyerTin         String?
  buyerName        String?
  // Null only on invoices imported from a filed annex, which carries no phone.
  buyerPhone       String?
  itemName         String
  quantity         Int       @default(1)
  // VAT-inclusive, as EBM takes them, to the cent: EBM works VAT out to two
  // decimals (a 5,000 sale carries 762.71 of VAT) and the annex must match.
  unitPrice        Decimal   @db.Decimal(14, 2)
  totalAmount      Decimal   @db.Decimal(14, 2)
  vatAmount        Decimal   @db.Decimal(14, 2)
  // "bank_transfer" (bank slip, Pesapal) | "mobile_money" | "bank_cheque".
  // Null on an imported invoice; the annex does not say how it was paid.
  paymentMethod    String?
  // When the money arrived, not when the invoice was issued. Null as above.
  paymentDate      DateTime?
  paymentReference String?
  // "draft" (not yet in EBM) | "issued" | "void" (cancelled with a refund
  // receipt in EBM; kept for the audit trail, left out of every total)
  status           String    @default("draft")
  receiptNumber    String?
  sdcId            String?
  // The date printed on the EBM receipt. It decides the VAT period.
  receiptDate      DateTime?
  voidReason       String?
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([sdcId, receiptNumber])
  @@index([status])
  @@index([receiptDate])
  @@index([leadId])
}

// Something Madar Hub bought. With the supplier's TIN and an EBM receipt
// (receipt number and SDC ID) its VAT is claimable as input VAT; without them
// it still counts as an expense for the annual income tax return.
model Purchase {
  id            String   @id @default(cuid())
  supplierTin   String?
  supplierName  String
  description   String?
  category      String
  purchaseDate  DateTime
  receiptNumber String?
  sdcId         String?
  // VAT-inclusive total and the VAT within it, to the cent; 0 VAT for an
  // untaxed purchase. VAT is taken from the receipt, not worked out: a receipt
  // mixing taxed and untaxed items carries less than 18/118 of its total.
  totalAmount   Decimal  @db.Decimal(14, 2)
  vatAmount     Decimal  @default(0) @db.Decimal(14, 2)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([purchaseDate])
}
